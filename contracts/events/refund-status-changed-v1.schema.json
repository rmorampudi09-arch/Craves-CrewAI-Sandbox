{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.craves.in/events/refund-status-changed-v1.schema.json",
  "title": "Craves REFUND_STATUS_CHANGED v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "source",
    "subject",
    "data"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "REFUND_STATUS_CHANGED" },
    "eventVersion": { "const": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "source": { "const": "integration-service" },
    "subject": { "type": "string", "format": "uuid" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refundId",
        "checkoutId",
        "chefSubOrderId",
        "customerIdentityId",
        "refundReference",
        "refundAmount",
        "currency",
        "reason",
        "status",
        "providerStatus",
        "cfRefundId",
        "updatedAt"
      ],
      "properties": {
        "refundId": { "type": "string", "format": "uuid" },
        "checkoutId": { "type": "string", "format": "uuid" },
        "chefSubOrderId": { "type": "string", "format": "uuid" },
        "customerIdentityId": { "type": "string", "format": "uuid" },
        "refundReference": { "type": "string", "minLength": 3, "maxLength": 40 },
        "refundAmount": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "const": "INR" },
        "reason": { "enum": ["CHEF_DECLINED", "CHEF_ACCEPTANCE_TIMEOUT"] },
        "status": { "enum": ["REFUND_PENDING", "REFUNDED", "REFUND_FAILED"] },
        "providerStatus": { "enum": ["PENDING", "ONHOLD", "SUCCESS", "FAILED", "CANCELLED"] },
        "cfRefundId": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
