{
  "name": "@craves/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Craves React Native bootstrap shell",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.74.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.2.0",
    "@types/jest": "29.5.12",
    "@types/react": "18.2.66",
    "@types/react-test-renderer": "18.0.7",
    "jest": "29.7.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "react-native",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
