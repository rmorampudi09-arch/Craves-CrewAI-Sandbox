{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["jest", "react", "react-native"]
  },
  "include": ["src", "__tests__"]
}
