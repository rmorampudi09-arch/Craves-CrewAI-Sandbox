('GET','/api/v1/chef/application','Read chef application','Authenticated user','Returns current chef application state.'),('POST','/api/v1/chef/application','Submit chef application','Authenticated user','Creates or updates chef onboarding information.'),('POST','/api/v1/chef/application/proof-files','Upload chef proof files','Authenticated user','Uploads KYC/proof files through the documented storage boundary.'),('GET','/api/v1/backoffice/chef-reviews?status=PENDING','List chef reviews','ADMIN','Backoffice review queue.'),('POST','/api/v1/backoffice/chef-reviews/{applicationId}/approve','Approve chef','ADMIN','Approves eligible application and changes protected chef state.'),('POST','/api/v1/backoffice/chef-reviews/{applicationId}/reject','Reject chef','ADMIN','Rejects an application using the protected review flow.'),
('GET','/api/v1/discovery/kitchens','Nearby kitchens','Customer','Requires latitude, longitude, radiusMeters; PostGIS orders eligible kitchens by distance.'),('GET','/api/v1/discovery/menu-items','Nearby menu items','Customer','Returns sellable nearby items with kitchen, package and primary-image metadata.'),('GET','/api/v1/catalog/kitchens','Public kitchen catalog','Customer','Compatibility route for existing clients.'),('GET','/api/v1/catalog/kitchens/{kitchenId}/menu-items','Kitchen menu','Customer','Returns menu items for a selected kitchen.'),('GET','/api/v1/kitchens/me','Read own kitchen','CHEF','Returns the approved chef’s kitchen profile.'),('PUT','/api/v1/kitchens/me','Update own kitchen','CHEF','Creates/updates the chef-owned kitchen profile.'),('GET','/api/v1/kitchens/me/menu-items','List own menu items','CHEF','Returns menu items owned by the chef kitchen.'),('POST','/api/v1/kitchens/me/menu-items','Create menu item','CHEF','Requires sellable details including package weight and thermobox decision.'),('PATCH','/api/v1/kitchens/me/menu-items/{menuItemId}/availability','Change availability','CHEF / owner','Changes only an owned menu item.'),
('GET','/api/v1/cart','Read cart','USER','Returns backend-authoritative cart state.'),('POST','/api/v1/cart/items','Add cart item','USER','Adds a valid sellable catalog item.'),('PUT','/api/v1/cart/items/{cartItemId}','Change cart quantity','USER / owner','Updates quantity after validation.'),('DELETE','/api/v1/cart/items/{cartItemId}','Remove cart item','USER / owner','Removes one cart item.'),('POST','/api/v1/cart/validate','Validate cart','USER','Re-checks current catalog state before checkout.'),('POST','/api/v1/checkout','Create checkout','USER','Requires saved deliveryAddressId; creates immutable drop-off/pickup and item/package snapshots.'),('GET','/api/v1/checkout/{checkoutId}','Read checkout','USER / owner','Returns an owned checkout.'),('GET','/api/v1/orders','List customer orders','USER','Returns customer-owned orders.'),('GET','/api/v1/orders/{orderId}','Read order','USER / owner','Returns one owned order.'),('GET','/api/v1/chef/orders','List chef orders','CHEF','Returns chef-owned order work.'),('POST','/api/v1/chef/orders/{orderId}/accept','Accept chef order','CHEF / owner','Requires positive prepTimeMinutes and persists ready_at.'),('POST','/api/v1/chef/orders/{orderId}/ready-for-pickup','Mark ready for pickup','CHEF / owner','Moves an eligible accepted order to the ready state.'),('GET','/api/v1/admin/charge-policy/current','Read current charge policy','ADMIN','Reads the active order charge policy.'),('POST','/api/v1/admin/charge-policy','Create charge policy','ADMIN','Protected finance/operations configuration; current seeded V1 fees are zero unless changed.'),
('GET','/api/v1/subscriptions/plans','List subscription plans','Authenticated customer','Lists available plan foundations.'),('POST','/api/v1/subscriptions','Create subscription','USER','Creates a customer subscription subject to current lifecycle rules.'),('GET','/api/v1/subscriptions','List subscriptions','USER','Returns customer subscriptions.'),('PATCH','/api/v1/subscriptions/{subscriptionId}/pause','Pause subscription','USER / owner','Applies supported pause transition.'),('PATCH','/api/v1/subscriptions/{subscriptionId}/cancel','Cancel subscription','USER / owner','Applies supported cancellation transition.'),
